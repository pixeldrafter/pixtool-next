# ==============================================================================
#  PIXTOOL NEXT — ORTAM DEĞİŞKENLERİ (ÖRNEK ŞABLON)
# ==============================================================================
#  KULLANIM:
#    1) Bu dosyayı ".env" olarak kopyala
#    2) Değerleri doldur
#    3) ".env" ASLA git'e eklenmez (.gitignore içinde)
#
#  ⚠️  Gerçek şifre/token değerlerini sohbet ortamına veya herhangi bir
#      paylaşılan dosyaya yazma. Yalnızca yerel ".env" içinde tut.
# ==============================================================================

# ------------------------------------------------------------------------------
#  1) UYGULAMA
# ------------------------------------------------------------------------------
APP_NAME=Pixtool Next
APP_ENV=development
APP_LANG=tr
APP_VERSION=0.1.0
DEBUG=true

# ------------------------------------------------------------------------------
#  2) BACKEND API
# ------------------------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000
API_PORT=8000
API_SECRET_KEY=
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
#  3) WEB ARAYÜZ
# ------------------------------------------------------------------------------
WEB_BASE_URL=http://127.0.0.1:5173

# ------------------------------------------------------------------------------
#  4) NOCODB  (tüm veri katmanı)
# ------------------------------------------------------------------------------
NOCODB_BASE_URL=
NOCODB_API_TOKEN=
NOCODB_BASE_ID=

# Tablo adları (oluşturuldukça doldurulur)
NOCODB_TABLE_USERS=
NOCODB_TABLE_DEVICES=
NOCODB_TABLE_SCRIPTS=
NOCODB_TABLE_RESOURCES=
NOCODB_TABLE_LOGS=
NOCODB_TABLE_SETTINGS=

# ------------------------------------------------------------------------------
#  5) N8N  (login / OTP / Telegram otomasyonu)
# ------------------------------------------------------------------------------
N8N_BASE_URL=
N8N_LOGIN_WEBHOOK=
N8N_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
#  6) TELEGRAM  (OTP ve bildirimler)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
#  7) YEREL KÖPRÜ  (localhost Python servisi — Faz 3)
# ------------------------------------------------------------------------------
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
BRIDGE_TOKEN=

# ------------------------------------------------------------------------------
#  8) VERİTABANI SEÇİMİ
#     Kişisel kullanımda: nocodb
#     İleride seçilebilir olacak: nocodb | sqlite | mysql | postgres
# ------------------------------------------------------------------------------
DB_ADAPTER=nocodb
SQLITE_PATH=./data/pixtool.db

# ------------------------------------------------------------------------------
#  9) SUNUCU ERİŞİMİ  (geliştirme sırasında SSH)
# ------------------------------------------------------------------------------
SSH_DEFAULT_HOST=
SSH_DEFAULT_USER=
SSH_DEFAULT_PORT=22

# ------------------------------------------------------------------------------
# 10) GÜVENLİK / KOMUT POLİTİKASI
#     confirm    = her komut öncesi onay ister (önerilen)
#     whitelist  = sadece izinli komutlar çalışır
#     allow_all  = sınırsız (dikkat!)
# ------------------------------------------------------------------------------
COMMAND_POLICY=confirm

# ------------------------------------------------------------------------------
# 11) HEDEF PLATFORMLAR (bilgi amaçlı)
# ------------------------------------------------------------------------------
SUPPORTED_WINDOWS=10,11
SUPPORTED_LINUX=ubuntu,debian

# ------------------------------------------------------------------------------
# 12) KİMLİK DOĞRULAMA
#     Demo kullanıcı yalnızca APP_ENV != production iken ve n8n/Telegram
#     yapılandırılmamışken kullanılır. Gerçek entegrasyon kurulunca otomatik
#     olarak devre dışı kalır.
# ------------------------------------------------------------------------------
AUTH_DEMO_USER=admin
AUTH_DEMO_PASSWORD=pixtool
AUTH_OTP_LENGTH=6
AUTH_OTP_MAX_ATTEMPTS=3
