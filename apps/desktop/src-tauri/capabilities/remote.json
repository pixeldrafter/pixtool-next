{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote",
  "description": "Sunucudan yüklenen arayüz (uzak origin) yetkileri — kabuk komut çalıştırma izni HARİÇ",
  "windows": [
    "main"
  ],
  "local": false,
  "remote": {
    "urls": [
      "https://pixtool.omercataloglu.com"
    ]
  },
  "permissions": [
    "core:default",
    "allow-bridge-start",
    "allow-bridge-stop",
    "allow-bridge-status",
    "allow-shell-version",
    "allow-ui-source",
    "allow-navigate-ui",
    "allow-reload-ui",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-is-maximized",
    "allow-window-close",
    "allow-window-set-fullscreen",
    "allow-window-is-fullscreen",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-title",
    "core:webview:allow-internal-toggle-devtools",
    "opener:default",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
