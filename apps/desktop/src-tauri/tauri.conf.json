{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixtool Next",
  "version": "1.2.0",
  "identifier": "com.omercataloglu.pixtool",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pixtool Next",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "theme": "Dark",
        "backgroundColor": "#0f0f0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pixtool-bridge"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "shortDescription": "Uzak sistem yönetim paneli",
    "longDescription": "Pixtool Next — uzak sistem yönetimi, script kütüphanesi, canlı makine envanteri ve Telegram doğrulamalı güvenli giriş.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOEUzQkUzRTAzMEIyOTUKUldTVnNqRGc0enVPWUdZbmxQRG9jMFVoc2tqV0VsSnBIbDQwdlBNak51dUNseTYxM2dnbHZiNDAK",
      "endpoints": [
        "https://pixtool.omercataloglu.com/api/v1/app/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
